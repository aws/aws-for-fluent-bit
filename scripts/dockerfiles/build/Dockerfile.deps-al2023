FROM public.ecr.aws/amazonlinux/amazonlinux:2023

RUN dnf upgrade -y && \
    dnf install -y  \
      glibc-devel \
      libyaml-devel \
      cmake \
      gcc \
      gcc-c++ \
      make \
      wget \
      unzip \
      tar \
      git \
      openssl-devel \
      cyrus-sasl-devel \
      pkgconf-pkg-config \
      systemd-devel \
      zlib-devel \
      valgrind-devel \
      ca-certificates \
      flex \
      bison \
    && dnf clean all
