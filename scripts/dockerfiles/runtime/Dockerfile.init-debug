ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}

# Run fluent_bit_init_process to generate the invoke script, extract the config path
# it produced, then hand off to core_uploader which supervises fluent-bit directly.
# FLB_CONF_FILE overrides the default config path in core_uploader.sh.
CMD /init/fluent_bit_init_process; \
    if [ -f /init/invoke_fluent_bit.sh ]; then \
        INVOKE_SCRIPT=/init/invoke_fluent_bit.sh; \
    elif [ -f /tmp/init/invoke_fluent_bit.sh ]; then \
        INVOKE_SCRIPT=/tmp/init/invoke_fluent_bit.sh; \
    else \
        echo "Error: invoke_fluent_bit.sh not found in /init or /tmp/init"; \
        exit 1; \
    fi; \
    # Extract the -c <config> path that init_process wrote into the invoke script.
    export FLB_CONF_FILE=$(grep -oP '(?<=-c )\S+' "$INVOKE_SCRIPT" | tail -1); \
    # Extract any -R <parser> paths and reassemble them as "-R path" args for fluent-bit.
    export FLB_EXTRA_ARGS=$(grep -oP '(?<=-R )\S+' "$INVOKE_SCRIPT" | sed 's/^/-R /' | tr '\n' ' '); \
    exec /core_uploader.sh
